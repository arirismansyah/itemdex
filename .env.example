# --- Database (PostgreSQL) -------------------------------------------------
# Tables are created automatically on first start (npm run db:migrate does it manually).
DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/itemdex-ai-builder
# DB_POOL_MAX=10

# --- AI model: any OpenAI-compatible vision server -------------------------
# Claude (https://api.anthropic.com), DeepSeek (https://api.deepseek.com), Gemini
# (https://generativelanguage.googleapis.com/v1beta/openai), OpenAI, Ollama, vLLM, ...
# The model MUST accept images. A Claude/Google subscription is not an API key.
# Can also be set in the app (gear icon), which overrides these three values.
LLM_API_BASE=https://your-ai-server
LLM_API_KEY=changeme
LLM_MODEL=your-model-name
# LLM_TIMEOUT_MS=120000

# --- Cards ------------------------------------------------------------------
# Language of description / notes on the card
CARD_LANGUAGE=Indonesian
CURRENCY=IDR
# Resale market used for price estimates
MARKET=Indonesian
# Coordinates -> address via OpenStreetMap Nominatim
REVERSE_GEOCODE=true

# --- Optional features ------------------------------------------------------
# Email/password sign-in with shared households (replaces ITEMDEX_API_KEY). Off = single user.
# ACCOUNTS=true

# --- Shopee price check ------------------------------------------------------
# Log in from the app (cart icon, local only). One-time: npx playwright-core install chromium
# SHOPEE_STATE=.itemdex/shopee-state.json
# Listings are asking prices; the value is set this fraction of the median
# COMPS_DISCOUNT=0.9

# --- Market price check (optional) -------------------------------------------
# Self-hosted SearXNG used to find second-hand listings and ground the value.
# One-time install: npm run search:setup
# With a local URL the service starts/stops SearXNG itself (no extra terminal).
# Empty = disabled (cards keep Gemma's own estimate).
SEARCH_URL=http://127.0.0.1:8888
# false = don't auto-start; run `npm run search` yourself or point SEARCH_URL elsewhere
# SEARCH_AUTOSTART=true
# SEARCH_LANGUAGE=id-ID
# SEARCH_TIMEOUT_MS=10000

# --- Service (npm run dev / npm start / Docker; the desktop app ignores these) ---
PORT=7777
# 0.0.0.0 = reachable from other devices (phone on the same Wi-Fi, server)
HOST=127.0.0.1
# REQUIRED when HOST is not 127.0.0.1
ITEMDEX_API_KEY=
# Web apps on other origins allowed to call the API, e.g. https://itemdex.example.com or *
CORS_ORIGINS=
# false = API only (web app hosted separately)
SERVE_UI=true
# false = no Swagger UI at /api/docs
API_DOCS=true
# Absolute base for image URLs when behind a proxy that rewrites the host
# PUBLIC_URL=https://api.itemdex.example.com
# BODY_LIMIT_MB=40
# LOG_LEVEL=info
